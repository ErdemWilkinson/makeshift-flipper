# ESP-IDF build artifacts
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# Editor/OS cruft
.vscode/
.claude/
.DS_Store
Thumbs.db

# Host test build output (tests/run_tests.sh)
tests/.build/

# Generated Python files and local installation logs
__pycache__/
*.py[cod]
voice/pip-install*.log

# Separate OCR and ASR experiments and the archived old MCU trees are kept
# out of the firmware repository. Their local files remain in the workspace.
ocr/
asr/
voice/
archive/

# Local-only workspace cruft: editor assistant caches, ad-hoc debug logs, a
# spare ASCII build tree, captured probe logs (personal data), and a stray
# old UI experiment. None of these belong in the firmware repo.
.continue/
.continueignore
.clangd
debug.log
build-c6-current/
tools/probe_logs/
# Stray root-level ui/ experiment only -- the real UI lives in main/ui/ and
# must stay tracked, so anchor this to the repo root (leading slash).
/ui/

# Active Wi-Fi packet injection (deauth) source is kept local only and out of
# the public repository: the project README states the device performs no
# deauthentication/injection, so this code must not ship in the repo. The files
# stay on disk but are not compiled (removed from main/CMakeLists.txt).
main/net/wifi_injection.c
main/net/wifi_injection.h
main/net/net_test.c
main/net/net_test.h
