# Enables Bluetooth (BLE-only on the C6 -- no classic BT/BR-EDR radio) via
# the lightweight NimBLE stack, used by bt_scan.c for the passive "BT Scan"
# feature. Written here (rather than requiring a manual "idf.py menuconfig"
# step) so a fresh `idf.py set-target esp32c6 && idf.py build` picks this up
# automatically -- see README.md's "Building" section.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# The default "single app" partition table only leaves 1MB for the app;
# WiFi + NimBLE BT + HTTP client/server together no longer fit in that
# (observed ~1.37MB linked binary). Bump both the assumed flash size and
# the partition table to the "large" single-app variant (1500K for the
# app) that ships with ESP-IDF, rather than hand-rolling a custom CSV.
# If your actual C6 board has less than 4MB flash, lower
# CONFIG_ESPTOOLPY_FLASHSIZE to match it.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
