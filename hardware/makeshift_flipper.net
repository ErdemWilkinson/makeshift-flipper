(export (version "E")
  (design
    (source "Makeshift Flipper - ESP32-C6-DEV-KIT-NX standalone")
    (date "2026-09-30")
    (tool "hand-written from firmware pin map (main/*.c/.h)")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "Makeshift Flipper")
        (company "ErdemWilkinson")
        (comment (number "1") (value "Nets match firmware: display.c, buttons.c, rc522.c, rdm6300.c, ir_driver.c, vibration.c, battery.c"))
        (comment (number "2") (value "Board: Waveshare ESP32-C6-DEV-KIT-NX. NEVER wire IO12/13 (USB) or IO16/17 (CH343 UART)."))
        (comment (number "3") (value "SCK(IO18)/MOSI(IO19) are shared between the LCD and RC522 on one SPI bus."))
        (comment (number "4") (value "RC522 and LCD are 3.3V. RDM6300 is 5V via a level shifter. Battery via 2:1 divider on IO3.")))))

  (components
    (comp (ref "U1")
      (value "ESP32-C6-DEV-KIT-NX")
      (footprint "Module:ESP32-C6-DEV-KIT-NX")
      (description "Main MCU module. All GPIO nets below reference this module's header pins by GPIO number."))
    (comp (ref "U2")
      (value "RC522")
      (footprint "Module:RC522-8pin-header")
      (description "13.56MHz RFID/NFC reader (MFRC522). SPI. 3.3V ONLY."))
    (comp (ref "U3")
      (value "RDM6300")
      (footprint "Module:RDM6300")
      (description "125kHz RFID reader. TX only, 5V powered; output crosses a level shifter to IO15."))
    (comp (ref "U4")
      (value "VS1838B")
      (footprint "OptoDevice:Vishay_MINICAST-3pin")
      (description "38kHz IR receiver. OUT -> IO4. 3.3V."))
    (comp (ref "U6")
      (value "LevelShifter-1ch")
      (footprint "Module:BSS138-level-shifter")
      (description "5V->3.3V level shifter for RDM6300 TX into IO15. HV=5V side, LV=3.3V side."))
    (comp (ref "Q1")
      (value "IR-LED-driver (NPN e.g. 2N2222 + 100R base)")
      (footprint "Package_TO_SOT_THT:TO-92_Inline")
      (description "Drives the IR transmit LED from IO0. Do NOT connect the LED directly to the GPIO."))
    (comp (ref "D1")
      (value "IR-LED-940nm")
      (footprint "LED_THT:LED_D5.0mm")
      (description "IR transmit LED, driven through Q1. Series resistor R3 sets current."))
    (comp (ref "R3")
      (value "100R")
      (footprint "Resistor_THT:R_Axial_DIN0207")
      (description "IR LED series current-limit resistor (tune to your LED/driver)."))
    (comp (ref "R4")
      (value "100R")
      (footprint "Resistor_THT:R_Axial_DIN0207")
      (description "Q1 base resistor from IO0."))
    (comp (ref "BZ1")
      (value "ActiveBuzzer")
      (footprint "Buzzer_Beeper:Buzzer_D12.0mm_H9.5mm")
      (description "ACTIVE buzzer (has its own oscillator). + to IO1, - to GND. No driver/diode needed."))
    (comp (ref "R1")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207")
      (description "Battery divider top: +BAT to node."))
    (comp (ref "R2")
      (value "10k")
      (footprint "Resistor_THT:R_Axial_DIN0207")
      (description "Battery divider bottom: node to GND. R1==R2 gives 2:1, matching BATTERY_DIVIDER in battery.c."))
    (comp (ref "U5")
      (value "ST7789-1.8in-240x240")
      (footprint "Connector:LCD-ST7789-8pin")
      (description "SPI LCD. Shares SCK/MOSI with RC522. Already wired/working."))
    (comp (ref "J1")
      (value "LiPo-JST-PH2")
      (footprint "Connector_JST:JST_PH_B2B-PH-K")
      (description "Single-cell LiPo input. + goes to the battery divider (R1) and, if used, the charger; - is GND.")))

  (nets
    ;; ---------------- POWER ----------------
    (net (code "1") (name "+3V3")
      (node (ref "U1") (pin "3V3"))
      (node (ref "U2") (pin "VCC"))
      (node (ref "U4") (pin "VCC"))
      (node (ref "U5") (pin "VCC"))
      (node (ref "U6") (pin "LV")))
    (net (code "2") (name "+5V")
      (node (ref "U1") (pin "5V"))
      (node (ref "U3") (pin "VCC"))
      (node (ref "U6") (pin "HV")))
    (net (code "3") (name "GND")
      (node (ref "U1") (pin "GND"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "GND"))
      (node (ref "U4") (pin "GND"))
      (node (ref "U5") (pin "GND"))
      (node (ref "U6") (pin "GND"))
      (node (ref "Q1") (pin "E"))
      (node (ref "BZ1") (pin "-"))
      (node (ref "R2") (pin "2"))
      (node (ref "J1") (pin "2")))
    (net (code "4") (name "+BAT")
      (node (ref "J1") (pin "1"))
      (node (ref "R1") (pin "1")))

    ;; ---------------- SHARED SPI BUS (LCD + RC522) ----------------
    (net (code "10") (name "SPI_SCK/IO18")
      (node (ref "U1") (pin "IO18"))
      (node (ref "U5") (pin "SCK"))
      (node (ref "U2") (pin "SCK")))
    (net (code "11") (name "SPI_MOSI/IO19")
      (node (ref "U1") (pin "IO19"))
      (node (ref "U5") (pin "MOSI/SDA"))
      (node (ref "U2") (pin "MOSI")))
    (net (code "12") (name "SPI_MISO/IO5")
      (node (ref "U1") (pin "IO5"))
      (node (ref "U2") (pin "MISO")))

    ;; ---------------- LCD control lines ----------------
    (net (code "13") (name "LCD_CS/IO9")
      (node (ref "U1") (pin "IO9"))
      (node (ref "U5") (pin "CS")))
    (net (code "14") (name "LCD_DC/IO8")
      (node (ref "U1") (pin "IO8"))
      (node (ref "U5") (pin "DC")))
    (net (code "15") (name "LCD_RST/IO20")
      (node (ref "U1") (pin "IO20"))
      (node (ref "U5") (pin "RST")))
    (net (code "16") (name "LCD_BL/IO21")
      (node (ref "U1") (pin "IO21"))
      (node (ref "U5") (pin "BL")))

    ;; ---------------- RC522 chip control ----------------
    (net (code "20") (name "RC522_CS/IO7")
      (node (ref "U1") (pin "IO7"))
      (node (ref "U2") (pin "SDA/CS")))
    (net (code "21") (name "RC522_RST/IO2")
      (node (ref "U1") (pin "IO2"))
      (node (ref "U2") (pin "RST")))

    ;; ---------------- RDM6300 (125kHz) via level shifter ----------------
    (net (code "30") (name "RDM6300_TX_5V")
      (node (ref "U3") (pin "TX"))
      (node (ref "U6") (pin "HV1")))
    (net (code "31") (name "RDM6300_TX_3V3/IO15")
      (node (ref "U6") (pin "LV1"))
      (node (ref "U1") (pin "IO15")))

    ;; ---------------- IR receive ----------------
    (net (code "40") (name "IR_RX/IO4")
      (node (ref "U1") (pin "IO4"))
      (node (ref "U4") (pin "OUT")))

    ;; ---------------- IR transmit (through driver) ----------------
    (net (code "41") (name "IR_TX/IO0")
      (node (ref "U1") (pin "IO0"))
      (node (ref "R4") (pin "1")))
    (net (code "42") (name "Q1_BASE")
      (node (ref "R4") (pin "2"))
      (node (ref "Q1") (pin "B")))
    (net (code "43") (name "IRLED_CATHODE")
      (node (ref "Q1") (pin "C"))
      (node (ref "D1") (pin "K")))
    (net (code "44") (name "IRLED_ANODE_R")
      (node (ref "D1") (pin "A"))
      (node (ref "R3") (pin "1")))
    (net (code "45") (name "IRLED_VCC")
      (node (ref "R3") (pin "2"))
      (node (ref "U1") (pin "3V3")))

    ;; ---------------- Buzzer (active, direct drive) ----------------
    (net (code "50") (name "BUZZER/IO1")
      (node (ref "U1") (pin "IO1"))
      (node (ref "BZ1") (pin "+")))

    ;; ---------------- Battery sense (2:1 divider) ----------------
    (net (code "60") (name "BATT_SENSE/IO3")
      (node (ref "U1") (pin "IO3"))
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1")))

    ;; ---------------- Buttons / joystick (direct GPIO, active-low) ----------------
    ;; These connect to the Pico-LCD-1.3's own switches; on a custom PCB wire
    ;; each switch between the listed GPIO and GND (the C6 uses internal pull-ups).
    (net (code "70") (name "BTN_UP/IO6")    (node (ref "U1") (pin "IO6")))
    (net (code "71") (name "BTN_DOWN/IO11") (node (ref "U1") (pin "IO11")))
    (net (code "72") (name "BTN_LEFT/IO23") (node (ref "U1") (pin "IO23")))
    (net (code "73") (name "BTN_RIGHT/IO22")(node (ref "U1") (pin "IO22")))
    (net (code "74") (name "BTN_A/IO10")    (node (ref "U1") (pin "IO10")))
  )
)
